PORT=5000
MONGO_URI=your_atlas_connection_string_here
AUTH_SECRET=replace-with-a-long-random-secret
GEMINI_API_KEY=replace-with-your-google-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
OCR_CONFIDENCE_THRESHOLD=0.80
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=30
SUPER_ADMIN_EMAIL=admin@pict.edu
SUPER_ADMIN_PASSWORD=replace-with-a-strong-admin-password
APP_URL=http://localhost:5173
# Optional email provider configuration. Without it, invite links are returned/logged locally.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
